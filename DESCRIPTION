Package: multibayes
Type: Package
Title: Bayesian Multiplicity Adjustments
Version: 0.2.0
Authors@R: c(
    person("Margherita", "Calderan", 
           email = "margherita.calderan@unipd.it",
           role = c("aut", "cre"),
           comment = c(ORCID = "0009-0005-5668-5162")),
    person("Filippo", "Gambarota",
           role = c("aut","ctb"),
           comment = c(ORCID = "0000-0002-6666-1747"))
